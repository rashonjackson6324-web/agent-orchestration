# Copy to .env and fill in. Never commit .env.

# root for agent logs, dbs and data
AGENT_HOME=~/.agent-network

# LLM inference
ANTHROPIC_API_KEY=

# monitored app (optional)
APP_URL=

# copy config/client_brief_prompt.example.md
CLIENT_BRIEF_TEMPLATE=config/client_brief_prompt.md

# watched folder for new client files
CLIENT_INBOX=~/data/new-client

# copy config/domains.example.json
DOMAINS_CONFIG=config/domains.json

# entry component filename
ENTRY_COMPONENT=App.jsx

# deployment host
GCP_IP=

GCP_USER=

# optional secondary model
GEMINI_API_KEY=

# repo intelligence agent
GITHUB_TOKEN=

# comma-separated repos to always score, e.g. owner/name,owner/name
WATCHED_REPOS=

# local data root
NETWORK_ROOT=./data

OBSIDIAN_VAULT_PATH=

# copy config/outreach_prompt.example.md
OUTREACH_TEMPLATE=config/outreach_prompt.md

# live web-grounded scoring (optional)
PERPLEXITY_API_KEY=

# app the deployment agent builds
PROJECT_PATH=./app

# monitored app (optional)
SECONDARY_APP_URL=

# copy config/stack_profile.example.md
STACK_PROFILE=config/stack_profile.md

# copy config/strategy_prompt.example.md
STRATEGY_PROMPT=config/strategy_prompt.md

SYNC_STATUS_FILE=

TELEGRAM_CHAT_ID=

# notification sink
TELEGRAM_TOKEN=

VAULT_INDEX=

# markdown knowledge base root
VAULT_ROOT=./vault

# knowledge-base workspace name
WORKSPACE_NAME=agents

# comma-separated command prefixes the executor is permitted to run
ALLOWED_COMMANDS=systemctl,journalctl,git,npm,python3,pytest,ls,df,uptime

# scripts the executor is allowed to run must live under this root
SCRIPT_ROOT=.
